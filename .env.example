# Supabase Configuration
# For local development, get these from: npx supabase status
# NEXT_PUBLIC_SUPABASE_URL should be: http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "Publishable" key
# SUPABASE_SERVICE_ROLE_KEY is the full JWT (not the short secret key)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt-token

# Razorpay Configuration (Test)
# Required for customer device-slot bookings and food orders.
# Without these, both flows refuse to take payment instead of booking for free.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret

# REQUIRED for online payments. Razorpay Dashboard -> Settings -> Webhooks.
#   URL:    https://<your-domain>/api/payment/webhook
#   Events: payment.captured
# This webhook is the safety net that creates the booking when a customer pays
# and closes the tab before the browser can call back. Without this secret the
# endpoint returns 503 and those payments are taken with no booking created.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Razorpay Configuration (Live - use after KYC)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-live-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-live-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-live-webhook-secret

# MSG91 Configuration
# Get your Auth Key from: https://control.msg91.com/app/settings/authkey
MSG91_AUTH_KEY=your-msg91-auth-key

# Optional: Sender ID (defaults to BRKPNT if not set)
MSG91_SENDER_ID=BRKPNT

# REQUIRED in India, on both API modes below - a DLT-registered template is a
# TRAI requirement, not an MSG91 one, so "no template needed" never really meant
# no template. Create the template under MSG91 > SendOTP > Templates (not Flow),
# attach your approved DLT template ID to it there, and put MSG91's own
# template ID (not the DLT one) here.
MSG91_TEMPLATE_ID_OTP=your-otp-template-id
# Only used by the Flow API (booking/subscription confirmations), not OTP login.
MSG91_TEMPLATE_ID_BOOKING=your-booking-confirmation-template-id
MSG91_TEMPLATE_ID_SUBSCRIPTION=your-subscription-confirmation-template-id

# MSG91 API Mode (choose one):
# Option 1: Use SendOTP API (simpler) - Set to 'true'. Still needs the DLT
# template above; "simpler" means no manual variable-mapping, not no template.
# Option 2: Use Flow API (template-based) - Set to 'false'
MSG91_USE_SENDOTP_API=true

# How long to wait on MSG91 before giving up, in milliseconds. Optional;
# defaults to 10000. There was no limit at all until a hung request started
# showing customers a send failure for an SMS MSG91 had already accepted.
MSG91_TIMEOUT_MS=10000

# Development: restrict real SMS to specific numbers.
# With MSG91_TEST_MODE=false, only the numbers listed here receive an actual SMS;
# every other number logs its OTP to the server console instead. This lets you
# exercise the full live flow while spending credits on one handset.
# Comma-separated, 10 digits each. LEAVE EMPTY IN PRODUCTION - an empty or unset
# value means no allowlist, i.e. every number is live.
MSG91_LIVE_SMS_NUMBERS=

# Development: Enable test mode to skip real SMS (OTP logged to console)
# Set to 'true' for testing without MSG91 credentials
# Set to 'false' for production with real SMS
MSG91_TEST_MODE=false

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAFE_NAME="Break Point Arena"

# Session Configuration
SESSION_SECRET=your-random-session-secret-min-32-chars
SESSION_EXPIRY_DAYS=7

# REQUIRED for OTP login. Keys the HMAC that OTP codes are hashed with, so a
# database read cannot recover a code that is currently in flight.
# Must be >= 32 chars; OTP sending refuses to run without it.
# Generate with:  openssl rand -hex 32
# Falls back to SESSION_SECRET when unset, but set it explicitly in production so
# rotating one does not silently invalidate the other.
OTP_HASH_SECRET=your-random-otp-hash-secret-min-32-chars

# How long a customer stays signed in after verifying, in minutes.
# Default 12 hours. Covers a full trading day, so a customer who books in the
# morning can order food and check their booking that evening without paying
# for another SMS. Lower it if shared devices are a concern - there is a
# sign-out button in the header either way.
CUSTOMER_SESSION_MINUTES=720

# Optional OTP tuning (defaults shown)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_REQUESTS_PER_PHONE=3

# Booking Configuration
SLOT_LOCK_MINUTES=10
LATE_ARRIVAL_GRACE_MINUTES=15
ADVANCE_BOOKING_DAYS=7
